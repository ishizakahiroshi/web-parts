{
  "name": "@ishizakahiroshi/share-parts",
  "version": "0.1.0",
  "description": "Share buttons without tracking: native share with copy fallback, LINE, mail and a destination-only route link. Framework-free core with thin React and DOM views.",
  "license": "MIT",
  "author": "Hiroshi Ishizaka (ishizakahiroshi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishizakahiroshi/web-parts.git",
    "directory": "packages/share-parts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check:dist": "node scripts/check-dist.mjs",
    "prepack": "pnpm run build && pnpm run check:dist",
    "examples": "vite examples"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^31.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
